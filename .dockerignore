# .dockerignore for SignalEngine Docker builds
# Context: This file is copied to the build context root (TradingPlatform/)
# because SignalEngine depends on sibling directories (LoggingEngine, databaseschema, etc.)

# Git directories - excluded at all levels
.git
**/.git

# Build artifacts (large, will be rebuilt in container)
target
**/target

# Cargo cache
.cargo
**/.cargo

# IDE files
.idea
.vscode
**/.idea
**/.vscode

# Not needed for SignalEngine build  
SimulationEngine
scripts
deepbook-ts
deepbook-test
combined

# Documentation (reduces context size)
*.md
**/*.md

# Other unnecessary files
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
