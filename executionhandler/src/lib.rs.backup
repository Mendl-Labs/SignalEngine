use std::collections::HashMap;
use std::sync::Arc;
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
use tokio::sync::{RwLock, mpsc, Mutex};
use tokio::time::{timeout, sleep};
use futures_util::{SinkExt, StreamExt};
use serde::{Serialize, Deserialize};
use tracing::{info, warn, error, debug, trace};
use anyhow::{Result, Context};
use thiserror::Error;
use dashmap::DashMap;
use arc_swap::ArcSwap;
use smallvec::SmallVec;

use signalgenerator::Signal;
use smartorderrouter::{SmartOrderRoute, ChildOrder, OrderSide, OrderType};

/// Ultra-low latency execution handler errors
#[derive(Error, Debug)]
pub enum ExecutionError {
    #[error("Connection error: {0}")]
    Connection(String),
    #[error("Authentication failed: {0}")]
    Authentication(String),
    #[error("Order validation failed: {0}")]
    Validation(String),
    #[error("Exchange error: {0}")]
    Exchange(String),
    #[error("Timeout error: {0}")]
    Timeout(String),
    #[error("Serialization error: {0}")]
    Serialization(#[from] serde_json::Error),
    #[error("HTTP error: {0}")]
    Http(#[from] reqwest::Error),
    #[error("WebSocket error: {0}")]
    WebSocket(String),
    #[error("Rate limit exceeded: {0}")]
    RateLimit(String),
}

/// Order execution status
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub enum ExecutionStatus {
    Pending,
    Submitted,
    PartiallyFilled,
    Filled,
    Cancelled,
    Rejected,
    Expired,
    Failed,
}

/// Execution fill information
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExecutionFill {
    pub order_id: String,
    pub exchange_order_id: String,
    pub fill_id: String,
    pub symbol: String,
    pub side: OrderSide,
    pub quantity: f64,
    pub price: f64,
    pub fee: f64,
    pub fee_currency: String,
    pub timestamp: u64,
    pub trade_id: Option<String>,
    pub is_maker: bool,
}

/// Order execution result
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExecutionResult {
    pub order_id: String,
    pub exchange_order_id: Option<String>,
    pub status: ExecutionStatus,
    pub filled_quantity: f64,
    pub remaining_quantity: f64,
    pub avg_fill_price: f64,
    pub total_fees: f64,
    pub fills: Vec<ExecutionFill>,
    pub reject_reason: Option<String>,
    pub submitted_at: u64,
    pub updated_at: u64,
    pub latency_ms: f64,
}

/// Performance metrics for execution
#[derive(Debug, Clone, Default, Serialize, Deserialize)]
pub struct ExecutionMetrics {
    pub total_orders: u64,
    pub successful_orders: u64,
    pub failed_orders: u64,
    pub cancelled_orders: u64,
    pub avg_latency_ms: f64,
    pub min_latency_ms: f64,
    pub max_latency_ms: f64,
    pub p50_latency_ms: f64,
    pub p95_latency_ms: f64,
    pub p99_latency_ms: f64,
    pub total_volume: f64,
    pub total_fees: f64,
    pub fill_rate: f64,
    pub error_rate: f64,
    pub last_updated: u64,
}

/// Kraken API credentials
#[derive(Debug, Clone)]
pub struct KrakenCredentials {
    pub api_key: String,
    pub secret_key: String,
}

/// Kraken REST API order request
#[derive(Debug, Serialize)]
struct KrakenOrderRequest {
    pair: String,
    #[serde(rename = "type")]
    order_type: String,
    ordertype: String,
    volume: String,
    #[serde(skip_serializing_if = "Option::is_none")]
    price: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    price2: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    leverage: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    oflags: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    starttm: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    expiretm: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    userref: Option<String>,
    #[serde(skip_serializing_if = "Option::is_none")]
    validate: Option<bool>,
}

/// Kraken API response wrapper
#[derive(Debug, Deserialize)]
struct KrakenResponse<T> {
    error: Vec<String>,
    result: Option<T>,
}

/// Kraken order response
#[derive(Debug, Deserialize)]
struct KrakenOrderResult {
    descr: KrakenOrderDescription,
    txid: Vec<String>,
}

#[derive(Debug, Deserialize)]
struct KrakenOrderDescription {
    order: String,
    close: Option<String>,
}

/// Kraken WebSocket message types
#[derive(Debug, Deserialize)]
#[serde(untagged)]
enum KrakenWsMessage {
    OrderUpdate {
        order_id: String,
        status: String,
        filled_volume: String,
        avg_price: String,
        cost: String,
        fee: String,
    },
    TradeUpdate(Vec<serde_json::Value>),
    SystemStatus {
        status: String,
        version: String,
    },
    Subscription {
        #[serde(rename = "channelID")]
        channel_id: u32,
        #[serde(rename = "channelName")]
        channel_name: String,
        event: String,
        pair: String,
        subscription: serde_json::Value,
    },
    Error {
        #[serde(rename = "errorMessage")]
        error_message: String,
        event: String,
    },
}

/// WebSocket connection manager
pub struct WebSocketManager {
    url: String,
    credentials: Option<KrakenCredentials>,
    sender: Option<Arc<Mutex<futures_util::stream::SplitSink<
        tokio_tungstenite::WebSocketStream<tokio_tungstenite::MaybeTlsStream<tokio::net::TcpStream>>,
        tokio_tungstenite::tungstenite::Message,
    >>>>,
    is_connected: Arc<parking_lot::RwLock<bool>>,
    reconnect_attempts: Arc<parking_lot::RwLock<u32>>,
    max_reconnect_attempts: u32,
    reconnect_delay: Duration,
}

impl WebSocketManager {
    pub fn new(url: String, credentials: Option<KrakenCredentials>) -> Self {
        Self {
            url,
            credentials,
            sender: None,
            is_connected: Arc::new(parking_lot::RwLock::new(false)),
            reconnect_attempts: Arc::new(parking_lot::RwLock::new(0)),
            max_reconnect_attempts: 10,
            reconnect_delay: Duration::from_millis(1000),
        }
    }

    pub async fn connect(
        &mut self,
        message_sender: mpsc::UnboundedSender<KrakenWsMessage>,
    ) -> Result<()> {
        let (ws_stream, _) = tokio_tungstenite::connect_async(&self.url)
            .await
            .context("Failed to connect to WebSocket")?;

        let (mut sink, mut stream) = ws_stream.split();

        // Authentication if credentials provided
        if let Some(ref creds) = self.credentials {
            self.authenticate(&mut sink, creds).await?;
        }

        self.sender = Some(Arc::new(Mutex::new(sink)));
        *self.is_connected.write() = true;
        *self.reconnect_attempts.write() = 0;

        // Spawn message handling task
        let message_sender_clone = message_sender;
        let is_connected = Arc::clone(&self.is_connected);
        
        tokio::spawn(async move {
            while let Some(msg) = stream.next().await {
                match msg {
                    Ok(tokio_tungstenite::tungstenite::Message::Text(text)) => {
                        trace!("Received WebSocket message: {}", text);
                        
                        match serde_json::from_str::<KrakenWsMessage>(&text) {
                            Ok(parsed_msg) => {
                                if message_sender_clone.send(parsed_msg).is_err() {
                                    error!("Failed to send parsed message to handler");
                                    break;
                                }
                            }
                            Err(e) => {
                                warn!("Failed to parse WebSocket message: {}, error: {}", text, e);
                            }
                        }
                    }
                    Ok(tokio_tungstenite::tungstenite::Message::Close(_)) => {
                        info!("WebSocket connection closed");
                        *is_connected.write() = false;
                        break;
                    }
                    Err(e) => {
                        error!("WebSocket error: {}", e);
                        *is_connected.write() = false;
                        break;
                    }
                    _ => {}
                }
            }
        });

        Ok(())
    }

    async fn authenticate(
        &self,
        sink: &mut futures_util::stream::SplitSink<
            tokio_tungstenite::WebSocketStream<tokio_tungstenite::MaybeTlsStream<tokio::net::TcpStream>>,
            tokio_tungstenite::tungstenite::Message,
        >,
        _creds: &KrakenCredentials,
    ) -> Result<()> {
        // Kraken WebSocket authentication
        let auth_msg = serde_json::json!({
            "event": "subscribe",
            "subscription": {"name": "ownTrades"}
        });

        sink.send(tokio_tungstenite::tungstenite::Message::Text(auth_msg.to_string()))
            .await
            .context("Failed to send authentication message")?;

        Ok(())
    }

    pub async fn send_message(&self, message: serde_json::Value) -> Result<()> {
        if let Some(ref sender) = self.sender {
            let mut sink = sender.lock().await;
            sink.send(tokio_tungstenite::tungstenite::Message::Text(message.to_string()))
                .await
                .context("Failed to send WebSocket message")?;
            Ok(())
        } else {
            Err(ExecutionError::Connection("WebSocket not connected".to_string()).into())
        }
    }

    pub fn is_connected(&self) -> bool {
        *self.is_connected.read()
    }
}

/// Ultra-low latency execution handler
pub struct UltraLowLatencyExecutionHandler {
    // Core components
    exchange_name: String,
    credentials: KrakenCredentials,
    
    // HTTP client for REST API
    http_client: reqwest::Client,
    base_url: String,
    
    // WebSocket manager for real-time updates
    ws_manager: Arc<Mutex<WebSocketManager>>,
    
    // Order tracking
    active_orders: Arc<DashMap<String, ExecutionResult>>,
    execution_history: Arc<RwLock<Vec<ExecutionResult>>>,
    
    // Performance optimization
    metrics: Arc<ArcSwap<ExecutionMetrics>>,
    latency_buffer: Arc<Mutex<SmallVec<[f64; 1000]>>>,
    
    // Rate limiting
    rate_limiter: Arc<Mutex<RateLimiter>>,
    
    // Connection pooling and keep-alive
    connection_pool_size: usize,
    request_timeout: Duration,
    
    // Event handlers
    execution_callbacks: Arc<RwLock<Vec<Box<dyn Fn(&ExecutionResult) + Send + Sync>>>>,
    fill_callbacks: Arc<RwLock<Vec<Box<dyn Fn(&ExecutionFill) + Send + Sync>>>>,
    
    // Internal state
    is_running: Arc<parking_lot::RwLock<bool>>,
    worker_handles: Arc<Mutex<Vec<tokio::task::JoinHandle<()>>>>,
}

/// Rate limiter for API calls
struct RateLimiter {
    requests_per_second: u32,
    last_request_times: SmallVec<[Instant; 100]>,
    max_burst: u32,
}

impl RateLimiter {
    fn new(requests_per_second: u32, max_burst: u32) -> Self {
        Self {
            requests_per_second,
            last_request_times: SmallVec::new(),
            max_burst,
        }
    }

    async fn acquire(&mut self) -> Result<()> {
        let now = Instant::now();
        let window = Duration::from_secs(1);

        // Remove old requests outside the window
        self.last_request_times.retain(|time| now.duration_since(*time) < window);

        // Check if we can make a request
        if self.last_request_times.len() >= self.max_burst as usize {
            let oldest = self.last_request_times[0];
            let wait_time = window - now.duration_since(oldest);
            if wait_time > Duration::ZERO {
                sleep(wait_time).await;
            }
            self.last_request_times.remove(0);
        }

        self.last_request_times.push(now);
        Ok(())
    }
}

impl UltraLowLatencyExecutionHandler {
    /// Create a new ultra-low latency execution handler
    pub fn new(
        exchange_name: String,
        credentials: KrakenCredentials,
        connection_pool_size: Option<usize>,
        request_timeout_ms: Option<u64>,
    ) -> Self {
        // Configure HTTP client for maximum performance
        let http_client = reqwest::Client::builder()
            .pool_max_idle_per_host(connection_pool_size.unwrap_or(10))
            .pool_idle_timeout(Some(Duration::from_secs(90)))
            .timeout(Duration::from_millis(request_timeout_ms.unwrap_or(5000)))
            .tcp_keepalive(Some(Duration::from_secs(60)))
            .tcp_nodelay(true)
            .build()
            .expect("Failed to create HTTP client");

        // WebSocket manager for real-time updates
        let ws_manager = Arc::new(Mutex::new(WebSocketManager::new(
            "wss://ws-auth.kraken.com".to_string(),
            Some(credentials.clone()),
        )));

        Self {
            exchange_name,
            credentials,
            http_client,
            base_url: "https://api.kraken.com".to_string(),
            ws_manager,
            active_orders: Arc::new(DashMap::new()),
            execution_history: Arc::new(RwLock::new(Vec::with_capacity(10000))),
            metrics: Arc::new(ArcSwap::from_pointee(ExecutionMetrics::default())),
            latency_buffer: Arc::new(Mutex::new(SmallVec::new())),
            rate_limiter: Arc::new(Mutex::new(RateLimiter::new(20, 60))), // Kraken limits
            connection_pool_size: connection_pool_size.unwrap_or(10),
            request_timeout: Duration::from_millis(request_timeout_ms.unwrap_or(5000)),
            execution_callbacks: Arc::new(RwLock::new(Vec::new())),
            fill_callbacks: Arc::new(RwLock::new(Vec::new())),
            is_running: Arc::new(parking_lot::RwLock::new(false)),
            worker_handles: Arc::new(Mutex::new(Vec::new())),
        }
    }

    /// Start the execution handler
    pub async fn start(&self) -> Result<()> {
        if *self.is_running.read() {
            return Ok(());
        }

        *self.is_running.write() = true;
        
        // Start WebSocket connection
        self.start_websocket_connection().await?;
        
        // Start metrics update task
        self.start_metrics_task().await;
        
        // Start order status monitoring
        self.start_order_monitoring().await;

        info!("Ultra-low latency execution handler started for {}", self.exchange_name);
        Ok(())
    }

    /// Stop the execution handler
    pub async fn stop(&self) -> Result<()> {
        *self.is_running.write() = false;

        // Cancel all active orders
        self.cancel_all_orders().await?;

        // Stop worker tasks
        let mut handles = self.worker_handles.lock().await;
        for handle in handles.drain(..) {
            handle.abort();
        }

        info!("Ultra-low latency execution handler stopped");
        Ok(())
    }

    /// Execute a single order with ultra-low latency
    pub async fn execute_order(&self, signal: &Signal) -> Result<ExecutionResult> {
        let start_time = Instant::now();
        
        // Validate order
        self.validate_order(signal)?;

        // Rate limiting
        self.rate_limiter.lock().await.acquire().await?;

        // Convert signal to Kraken order format
        let kraken_request = self.signal_to_kraken_order(signal)?;
        
        // Execute order via REST API for immediate response
        let result = self.submit_order_rest(&kraken_request, signal).await?;
        
        // Calculate latency
        let latency_ms = start_time.elapsed().as_secs_f64() * 1000.0;
        
        // Update metrics
        self.update_latency_metrics(latency_ms).await;
        
        // Store active order
        self.active_orders.insert(result.order_id.clone(), result.clone());
        
        // Trigger callbacks
        self.trigger_execution_callbacks(&result).await;
        
        info!(
            "Order executed: {} in {:.2}ms", 
            result.order_id, 
            latency_ms
        );
        
        Ok(result)
    }

    /// Execute multiple orders in parallel with optimal batching
    pub async fn execute_batch_orders(&self, signals: &[Signal]) -> Result<Vec<ExecutionResult>> {
        let batch_size = std::cmp::min(signals.len(), 10); // Kraken batch limit
        let mut results = Vec::with_capacity(signals.len());
        
        for batch in signals.chunks(batch_size) {
            let batch_futures: Vec<_> = batch.iter()
                .map(|signal| self.execute_order(signal))
                .collect();
                
            let batch_results = futures_util::future::join_all(batch_futures).await;
            
            for result in batch_results {
                match result {
                    Ok(execution_result) => results.push(execution_result),
                    Err(e) => {
                        error!("Batch order execution failed: {}", e);
                        // Create failed result
                        results.push(ExecutionResult {
                            order_id: uuid::Uuid::new_v4().to_string(),
                            exchange_order_id: None,
                            status: ExecutionStatus::Failed,
                            filled_quantity: 0.0,
                            remaining_quantity: 0.0,
                            avg_fill_price: 0.0,
                            total_fees: 0.0,
                            fills: Vec::new(),
                            reject_reason: Some(e.to_string()),
                            submitted_at: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
                            updated_at: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
                            latency_ms: 0.0,
                        });
                    }
                }
            }
        }
        
        Ok(results)
    }

    /// Execute smart order route with child order management
    pub async fn execute_smart_route(&self, route: &SmartOrderRoute) -> Result<Vec<ExecutionResult>> {
        let mut results = Vec::new();
        
        for child_order in &route.child_orders {
            // Convert child order to signal
            let signal = self.child_order_to_signal(child_order, route)?;
            
            // Execute with retry logic for failed orders
            match self.execute_order_with_retry(&signal, 3).await {
                Ok(result) => {
                    results.push(result);
                }
                Err(e) => {
                    error!("Child order {} execution failed: {}", child_order.id, e);
                    // Continue with other orders even if one fails
                }
            }
            
            // Small delay between child orders to avoid overwhelming the exchange
            sleep(Duration::from_millis(10)).await;
        }
        
        Ok(results)
    }

    /// Cancel an order with ultra-low latency
    pub async fn cancel_order(&self, order_id: &str) -> Result<bool> {
        let start_time = Instant::now();
        
        // Rate limiting
        self.rate_limiter.lock().await.acquire().await?;
        
        // Cancel via REST API
        let success = self.cancel_order_rest(order_id).await?;
        
        if success {
            // Update order status
            if let Some(mut order) = self.active_orders.get_mut(order_id) {
                order.status = ExecutionStatus::Cancelled;
                order.updated_at = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64;
            }
            
            // Move to history
            if let Some((_, order)) = self.active_orders.remove(order_id) {
                self.execution_history.write().await.push(order);
            }
        }
        
        let latency_ms = start_time.elapsed().as_secs_f64() * 1000.0;
        debug!("Order {} cancelled in {:.2}ms", order_id, latency_ms);
        
        Ok(success)
    }

    /// Cancel all active orders
    pub async fn cancel_all_orders(&self) -> Result<Vec<String>> {
        let order_ids: Vec<String> = self.active_orders.iter()
            .map(|entry| entry.key().clone())
            .collect();
            
        let mut cancelled_orders = Vec::new();
        
        for order_id in order_ids {
            if let Ok(success) = self.cancel_order(&order_id).await {
                if success {
                    cancelled_orders.push(order_id);
                }
            }
        }
        
        Ok(cancelled_orders)
    }

    /// Get order status
    pub async fn get_order_status(&self, order_id: &str) -> Result<Option<ExecutionResult>> {
        if let Some(order) = self.active_orders.get(order_id) {
            Ok(Some(order.clone()))
        } else {
            // Check history
            let history = self.execution_history.read().await;
            Ok(history.iter().find(|o| o.order_id == order_id).cloned())
        }
    }

    /// Get execution metrics
    pub fn get_metrics(&self) -> ExecutionMetrics {
        self.metrics.load().as_ref().clone()
    }

    /// Add execution callback
    pub async fn add_execution_callback<F>(&self, callback: F)
    where
        F: Fn(&ExecutionResult) + Send + Sync + 'static,
    {
        self.execution_callbacks.write().await.push(Box::new(callback));
    }

    /// Add fill callback
    pub async fn add_fill_callback<F>(&self, callback: F)
    where
        F: Fn(&ExecutionFill) + Send + Sync + 'static,
    {
        self.fill_callbacks.write().await.push(Box::new(callback));
    }

    // Private implementation methods

    async fn start_websocket_connection(&self) -> Result<()> {
        let (tx, mut rx) = mpsc::unbounded_channel();
        
        // Connect WebSocket
        {
            let mut ws_manager = self.ws_manager.lock().await;
            ws_manager.connect(tx).await?;
        }
        
        // Handle WebSocket messages
        let active_orders = Arc::clone(&self.active_orders);
        let fill_callbacks = Arc::clone(&self.fill_callbacks);
        let execution_callbacks = Arc::clone(&self.execution_callbacks);
        let is_running = Arc::clone(&self.is_running);
        
        let handle = tokio::spawn(async move {
            while *is_running.read() {
                if let Some(msg) = rx.recv().await {
                    match msg {
                        KrakenWsMessage::OrderUpdate { order_id, status, filled_volume, avg_price, cost: _cost, fee } => {
                            if let Some(mut order) = active_orders.get_mut(&order_id) {
                                // Update order status
                                order.status = match status.as_str() {
                                    "open" => ExecutionStatus::Submitted,
                                    "closed" => ExecutionStatus::Filled,
                                    "canceled" => ExecutionStatus::Cancelled,
                                    _ => ExecutionStatus::Pending,
                                };
                                
                                // Update fill information
                                if let (Ok(filled_qty), Ok(price), Ok(fee_amount)) = (
                                    filled_volume.parse::<f64>(),
                                    avg_price.parse::<f64>(),
                                    fee.parse::<f64>(),
                                ) {
                                    order.filled_quantity = filled_qty;
                                    order.avg_fill_price = price;
                                    order.total_fees += fee_amount;
                                    order.remaining_quantity = (order.filled_quantity + order.remaining_quantity) - filled_qty;
                                    order.updated_at = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64;
                                    
                                    // Create fill event
                                    let fill = ExecutionFill {
                                        order_id: order_id.clone(),
                                        exchange_order_id: order.exchange_order_id.clone().unwrap_or_default(),
                                        fill_id: uuid::Uuid::new_v4().to_string(),
                                        symbol: "".to_string(), // Would need to be tracked
                                        side: OrderSide::Buy, // Would need to be tracked
                                        quantity: filled_qty,
                                        price,
                                        fee: fee_amount,
                                        fee_currency: "USD".to_string(),
                                        timestamp: order.updated_at,
                                        trade_id: None,
                                        is_maker: false,
                                    };
                                    
                                    // Trigger fill callbacks
                                    let callbacks = fill_callbacks.read().await;
                                    for callback in callbacks.iter() {
                                        callback(&fill);
                                    }
                                }
                                
                                // Trigger execution callbacks
                                let callbacks = execution_callbacks.read().await;
                                for callback in callbacks.iter() {
                                    callback(&*order);
                                }
                            }
                        },
                        KrakenWsMessage::Error { error_message, event: _event } => {
                            error!("WebSocket error: {}", error_message);
                        },
                        _ => {
                            trace!("Unhandled WebSocket message: {:?}", msg);
                        }
                    }
                } else {
                    break;
                }
            }
        });
        
        self.worker_handles.lock().await.push(handle);
        Ok(())
    }

    async fn start_metrics_task(&self) {
        let metrics = Arc::clone(&self.metrics);
        let active_orders = Arc::clone(&self.active_orders);
        let latency_buffer = Arc::clone(&self.latency_buffer);
        let is_running = Arc::clone(&self.is_running);
        
        let handle = tokio::spawn(async move {
            while *is_running.read() {
                sleep(Duration::from_secs(1)).await;
                
                // Calculate metrics
                let mut new_metrics = ExecutionMetrics::default();
                
                // Count orders by status
                for order in active_orders.iter() {
                    new_metrics.total_orders += 1;
                    match order.status {
                        ExecutionStatus::Filled => new_metrics.successful_orders += 1,
                        ExecutionStatus::Failed | ExecutionStatus::Rejected => new_metrics.failed_orders += 1,
                        ExecutionStatus::Cancelled => new_metrics.cancelled_orders += 1,
                        _ => {}
                    }
                    new_metrics.total_volume += order.filled_quantity;
                    new_metrics.total_fees += order.total_fees;
                }
                
                // Calculate latency metrics
                {
                    let mut buffer = latency_buffer.lock().await;
                    if !buffer.is_empty() {
                        buffer.sort_by(|a, b| a.partial_cmp(b).unwrap());
                        
                        new_metrics.avg_latency_ms = buffer.iter().sum::<f64>() / buffer.len() as f64;
                        new_metrics.min_latency_ms = buffer[0];
                        new_metrics.max_latency_ms = buffer[buffer.len() - 1];
                        new_metrics.p50_latency_ms = buffer[buffer.len() / 2];
                        new_metrics.p95_latency_ms = buffer[buffer.len() * 95 / 100];
                        new_metrics.p99_latency_ms = buffer[buffer.len() * 99 / 100];
                        
                        // Clear buffer to prevent unbounded growth
                        if buffer.len() > 10000 {
                            buffer.clear();
                        }
                    }
                }
                
                // Calculate rates
                if new_metrics.total_orders > 0 {
                    new_metrics.fill_rate = new_metrics.successful_orders as f64 / new_metrics.total_orders as f64;
                    new_metrics.error_rate = new_metrics.failed_orders as f64 / new_metrics.total_orders as f64;
                }
                
                new_metrics.last_updated = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64;
                
                // Update metrics atomically
                metrics.store(Arc::new(new_metrics));
            }
        });
        
        self.worker_handles.lock().await.push(handle);
    }

    async fn start_order_monitoring(&self) {
        let active_orders = Arc::clone(&self.active_orders);
        let execution_history = Arc::clone(&self.execution_history);
        let is_running = Arc::clone(&self.is_running);
        
        let handle = tokio::spawn(async move {
            while *is_running.read() {
                sleep(Duration::from_secs(10)).await;
                
                // Move completed orders to history
                let mut to_remove = Vec::new();
                
                for entry in active_orders.iter() {
                    let order = entry.value();
                    if matches!(order.status, ExecutionStatus::Filled | ExecutionStatus::Cancelled | ExecutionStatus::Failed | ExecutionStatus::Rejected) {
                        to_remove.push(entry.key().clone());
                    }
                }
                
                for order_id in to_remove {
                    if let Some((_, order)) = active_orders.remove(&order_id) {
                        execution_history.write().await.push(order);
                    }
                }
                
                // Cleanup old history entries
                {
                    let mut history = execution_history.write().await;
                    if history.len() > 100000 {
                        history.drain(0..50000);
                    }
                }
            }
        });
        
        self.worker_handles.lock().await.push(handle);
    }

    fn validate_order(&self, signal: &Signal) -> Result<()> {
        if signal.symbol.is_empty() {
            return Err(ExecutionError::Validation("Symbol is required".to_string()).into());
        }
        
        if signal.quantity <= 0.0 {
            return Err(ExecutionError::Validation("Quantity must be positive".to_string()).into());
        }
        
        Ok(())
    }

    fn signal_to_kraken_order(&self, signal: &Signal) -> Result<KrakenOrderRequest> {
        let pair = self.convert_symbol_to_kraken_pair(&signal.symbol)?;
        
        let (order_type, ordertype, price, price2) = match signal.action {
            signalgenerator::SignalAction::Buy => ("buy", "market", None, None),
            signalgenerator::SignalAction::Sell => ("sell", "market", None, None),
            signalgenerator::SignalAction::BuyLimit => {
                let price = signal.price.ok_or_else(|| 
                    ExecutionError::Validation("Limit orders require a price".to_string())
                )?;
                ("buy", "limit", Some(price.to_string()), None)
            },
            signalgenerator::SignalAction::SellLimit => {
                let price = signal.price.ok_or_else(|| 
                    ExecutionError::Validation("Limit orders require a price".to_string())
                )?;
                ("sell", "limit", Some(price.to_string()), None)
            },
            _ => return Err(ExecutionError::Validation("Unsupported order type".to_string()).into()),
        };

        Ok(KrakenOrderRequest {
            pair,
            order_type: order_type.to_string(),
            ordertype: ordertype.to_string(),
            volume: signal.quantity.to_string(),
            price,
            price2,
            leverage: None,
            oflags: None,
            starttm: None,
            expiretm: None,
            userref: Some(signal.id.clone()),
            validate: Some(false),
        })
    }

    fn convert_symbol_to_kraken_pair(&self, symbol: &str) -> Result<String> {
        // Convert common symbols to Kraken format
        let kraken_pair = match symbol {
            "BTC/USD" | "BTCUSD" => "XXBTZUSD",
            "ETH/USD" | "ETHUSD" => "XETHZUSD",
            "BTC/EUR" | "BTCEUR" => "XXBTZEUR",
            "ETH/EUR" | "ETHEUR" => "XETHZEUR",
            _ => symbol, // Pass through if not recognized
        };
        
        Ok(kraken_pair.to_string())
    }

    async fn submit_order_rest(&self, request: &KrakenOrderRequest, signal: &Signal) -> Result<ExecutionResult> {
        let url = format!("{}/0/private/AddOrder", self.base_url);
        let nonce = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis().to_string();
        
        // Prepare form data
        let mut form_data = HashMap::new();
        form_data.insert("nonce", nonce.clone());
        form_data.insert("pair", request.pair.clone());
        form_data.insert("type", request.order_type.clone());
        form_data.insert("ordertype", request.ordertype.clone());
        form_data.insert("volume", request.volume.clone());
        
        if let Some(ref price) = request.price {
            form_data.insert("price", price.clone());
        }
        
        if let Some(ref userref) = request.userref {
            form_data.insert("userref", userref.clone());
        }

        // Generate signature
        let signature = self.generate_signature("/0/private/AddOrder", &nonce, &form_data)?;
        
        // Make HTTP request
        let response = timeout(
            self.request_timeout,
            self.http_client
                .post(&url)
                .header("API-Key", &self.credentials.api_key)
                .header("API-Sign", signature)
                .form(&form_data)
                .send()
        ).await
        .context("Request timeout")?
        .context("HTTP request failed")?;

        let response_text = response.text().await?;
        let kraken_response: KrakenResponse<KrakenOrderResult> = serde_json::from_str(&response_text)
            .context("Failed to parse response")?;

        if !kraken_response.error.is_empty() {
            return Err(ExecutionError::Exchange(kraken_response.error.join(", ")).into());
        }

        let result = kraken_response.result.ok_or_else(|| 
            ExecutionError::Exchange("No result in response".to_string())
        )?;

        let exchange_order_id = result.txid.first()
            .ok_or_else(|| ExecutionError::Exchange("No transaction ID".to_string()))?;

        Ok(ExecutionResult {
            order_id: signal.id.clone(),
            exchange_order_id: Some(exchange_order_id.clone()),
            status: ExecutionStatus::Submitted,
            filled_quantity: 0.0,
            remaining_quantity: signal.quantity,
            avg_fill_price: 0.0,
            total_fees: 0.0,
            fills: Vec::new(),
            reject_reason: None,
            submitted_at: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
            updated_at: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
            latency_ms: 0.0,
        })
    }

    async fn cancel_order_rest(&self, order_id: &str) -> Result<bool> {
        let url = format!("{}/0/private/CancelOrder", self.base_url);
        let nonce = SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis().to_string();
        
        let mut form_data = HashMap::new();
        form_data.insert("nonce", nonce.clone());
        form_data.insert("txid", order_id.to_string());

        let signature = self.generate_signature("/0/private/CancelOrder", &nonce, &form_data)?;
        
        let response = timeout(
            self.request_timeout,
            self.http_client
                .post(&url)
                .header("API-Key", &self.credentials.api_key)
                .header("API-Sign", signature)
                .form(&form_data)
                .send()
        ).await??;

        let response_text = response.text().await?;
        let kraken_response: KrakenResponse<serde_json::Value> = serde_json::from_str(&response_text)?;

        if !kraken_response.error.is_empty() {
            warn!("Cancel order error: {}", kraken_response.error.join(", "));
            return Ok(false);
        }

        Ok(true)
    }

    fn generate_signature(&self, path: &str, nonce: &str, form_data: &HashMap<&str, String>) -> Result<String> {
        use hmac::{Hmac, Mac};
        use sha2::{Sha256, Sha512, Digest};
        use base64::{Engine as _, engine::general_purpose};

        // Create the message to sign
        let form_encoded = serde_urlencoded::to_string(form_data)?;
        let message = format!("{}{}", nonce, form_encoded);

        // SHA256 hash of the message
        let mut hasher = Sha256::new();
        hasher.update(message.as_bytes());
        let hash = hasher.finalize();

        // Create the full message with path
        let mut full_message = Vec::new();
        full_message.extend_from_slice(path.as_bytes());
        full_message.extend_from_slice(&hash);

        // HMAC-SHA512 with base64-decoded secret
        let secret = general_purpose::STANDARD.decode(&self.credentials.secret_key)?;
        let mut mac = Hmac::<Sha512>::new_from_slice(&secret)
            .map_err(|_| ExecutionError::Authentication("Invalid secret key".to_string()))?;
        mac.update(&full_message);
        let signature = mac.finalize().into_bytes();

        Ok(general_purpose::STANDARD.encode(signature))
    }

    async fn execute_order_with_retry(&self, signal: &Signal, max_retries: u32) -> Result<ExecutionResult> {
        let mut last_error = None;
        
        for attempt in 0..=max_retries {
            match self.execute_order(signal).await {
                Ok(result) => return Ok(result),
                Err(e) => {
                    last_error = Some(e);
                    if attempt < max_retries {
                        let delay = Duration::from_millis(100 * (attempt + 1) as u64);
                        sleep(delay).await;
                        warn!("Order execution retry {} for {}", attempt + 1, signal.id);
                    }
                }
            }
        }
        
        Err(last_error.unwrap())
    }

    fn child_order_to_signal(&self, child_order: &ChildOrder, _route: &SmartOrderRoute) -> Result<Signal> {
        let action = match (child_order.side, child_order.order_type) {
            (OrderSide::Buy, OrderType::Market) => signalgenerator::SignalAction::Buy,
            (OrderSide::Sell, OrderType::Market) => signalgenerator::SignalAction::Sell,
            (OrderSide::Buy, OrderType::Limit) => signalgenerator::SignalAction::BuyLimit,
            (OrderSide::Sell, OrderType::Limit) => signalgenerator::SignalAction::SellLimit,
            _ => return Err(ExecutionError::Validation("Unsupported order type".to_string()).into()),
        };

        Ok(Signal {
            id: child_order.id.clone(),
            strategy_id: "smart_router".to_string(),
            symbol: child_order.symbol.clone(),
            exchange: child_order.exchange.clone(),
            action,
            quantity: child_order.quantity,
            price: child_order.price,
            confidence: 1.0,
            timestamp: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
            metadata: std::collections::HashMap::new(),
        })
    }

    async fn update_latency_metrics(&self, latency_ms: f64) {
        let mut buffer = self.latency_buffer.lock().await;
        buffer.push(latency_ms);
        
        // Keep buffer size manageable
        if buffer.len() > 10000 {
            buffer.remove(0);
        }
    }

    async fn trigger_execution_callbacks(&self, result: &ExecutionResult) {
        let callbacks = self.execution_callbacks.read().await;
        for callback in callbacks.iter() {
            callback(result);
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use signalgenerator::SignalAction;

    fn create_test_credentials() -> KrakenCredentials {
        KrakenCredentials {
            api_key: "test_api_key".to_string(),
            secret_key: "dGVzdF9zZWNyZXRfa2V5".to_string(), // base64 encoded test key
        }
    }

    fn create_test_signal() -> Signal {
        Signal {
            id: "test_signal_1".to_string(),
            strategy_id: "test_strategy".to_string(),
            symbol: "BTC/USD".to_string(),
            exchange: "Kraken".to_string(),
            action: SignalAction::BuyLimit,
            quantity: 1.0,
            price: Some(50000.0),
            confidence: 0.8,
            timestamp: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
            metadata: HashMap::new(),
        }
    }

    #[tokio::test]
    async fn test_execution_handler_creation() {
        let credentials = create_test_credentials();
        let handler = UltraLowLatencyExecutionHandler::new(
            "Kraken".to_string(),
            credentials,
            Some(5),
            Some(3000),
        );

        assert_eq!(handler.exchange_name, "Kraken");
        assert_eq!(handler.connection_pool_size, 5);
        assert_eq!(handler.request_timeout, Duration::from_millis(3000));
    }

    #[tokio::test]
    async fn test_order_validation() {
        let credentials = create_test_credentials();
        let handler = UltraLowLatencyExecutionHandler::new(
            "Kraken".to_string(),
            credentials,
            None,
            None,
        );

        let signal = create_test_signal();
        assert!(handler.validate_order(&signal).is_ok());

        // Test invalid signal
        let mut invalid_signal = signal;
        invalid_signal.quantity = -1.0;
        assert!(handler.validate_order(&invalid_signal).is_err());
    }

    #[tokio::test]
    async fn test_signal_conversion() {
        let credentials = create_test_credentials();
        let handler = UltraLowLatencyExecutionHandler::new(
            "Kraken".to_string(),
            credentials,
            None,
            None,
        );

        let signal = create_test_signal();
        let kraken_order = handler.signal_to_kraken_order(&signal).unwrap();

        assert_eq!(kraken_order.pair, "XXBTZUSD");
        assert_eq!(kraken_order.order_type, "buy");
        assert_eq!(kraken_order.ordertype, "limit");
        assert_eq!(kraken_order.volume, "1");
        assert_eq!(kraken_order.price, Some("50000".to_string()));
    }

    #[tokio::test]
    async fn test_symbol_conversion() {
        let credentials = create_test_credentials();
        let handler = UltraLowLatencyExecutionHandler::new(
            "Kraken".to_string(),
            credentials,
            None,
            None,
        );

        assert_eq!(handler.convert_symbol_to_kraken_pair("BTC/USD").unwrap(), "XXBTZUSD");
        assert_eq!(handler.convert_symbol_to_kraken_pair("ETH/USD").unwrap(), "XETHZUSD");
        assert_eq!(handler.convert_symbol_to_kraken_pair("UNKNOWN").unwrap(), "UNKNOWN");
    }

    #[tokio::test]
    async fn test_metrics_initialization() {
        let credentials = create_test_credentials();
        let handler = UltraLowLatencyExecutionHandler::new(
            "Kraken".to_string(),
            credentials,
            None,
            None,
        );

        let metrics = handler.get_metrics();
        assert_eq!(metrics.total_orders, 0);
        assert_eq!(metrics.successful_orders, 0);
        assert_eq!(metrics.avg_latency_ms, 0.0);
    }

    #[tokio::test]
    async fn test_rate_limiter() {
        let mut rate_limiter = RateLimiter::new(10, 20);
        
        // Should allow initial requests
        assert!(rate_limiter.acquire().await.is_ok());
        assert!(rate_limiter.acquire().await.is_ok());
    }

    #[tokio::test]
    async fn test_order_status_tracking() {
        let credentials = create_test_credentials();
        let handler = UltraLowLatencyExecutionHandler::new(
            "Kraken".to_string(),
            credentials,
            None,
            None,
        );

        let order_id = "test_order_1";
        
        // Initially no order should exist
        assert!(handler.get_order_status(order_id).await.unwrap().is_none());
        
        // Add a mock order
        let execution_result = ExecutionResult {
            order_id: order_id.to_string(),
            exchange_order_id: Some("kraken_123".to_string()),
            status: ExecutionStatus::Submitted,
            filled_quantity: 0.0,
            remaining_quantity: 1.0,
            avg_fill_price: 0.0,
            total_fees: 0.0,
            fills: Vec::new(),
            reject_reason: None,
            submitted_at: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
            updated_at: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_millis() as u64,
            latency_ms: 15.5,
        };
        
        handler.active_orders.insert(order_id.to_string(), execution_result.clone());
        
        // Now should find the order
        let found_order = handler.get_order_status(order_id).await.unwrap();
        assert!(found_order.is_some());
        assert_eq!(found_order.unwrap().order_id, order_id);
    }
}
